{
  "name": "api",
  "projectType": "application",
  "sourceRoot": "apps/api/src",
  "targets": {
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node --watch --require ts-node/register apps/api/src/main.ts",
        "env": { "TS_NODE_PROJECT": "apps/api/tsconfig.json" }
      }
    },
    "build": {
      "command": "tsc -p apps/api/tsconfig.json",
      "outputs": ["{workspaceRoot}/dist/apps/api"]
    },
    "start": {
      "command": "node dist/apps/api/main.js"
    },
    "typecheck": {
      "command": "tsc -p apps/api/tsconfig.json --noEmit"
    }
  }
}
